{"nodes": [{"id": "fixing_0_0_0_0_redirect_issue", "label": "0.0.0.0 Redirect Issue", "file_type": "rationale", "source_file": "FIXING-0.0.0.0-REDIRECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binding Next.js dev server to 0.0.0.0 causes NextAuth to read 0.0.0.0 from request headers, so post-login/logout redirects point to the wrong host instead of the IP actually used to access the app."}, {"id": "fixing_0_0_0_0_redirect_nextauth_url", "label": "NEXTAUTH_URL Environment Variable", "file_type": "concept", "source_file": "FIXING-0.0.0.0-REDIRECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fixing_0_0_0_0_redirect_smart_redirect_callback", "label": "Smart Redirect Callback", "file_type": "rationale", "source_file": "FIXING-0.0.0.0-REDIRECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects hostname 0.0.0.0, prefers NEXTAUTH_URL, falls back to the referer header, and substitutes the correct hostname so redirects work automatically across dev/LAN/production without manually swapping env values every time."}, {"id": "fixing_0_0_0_0_redirect_auth_config_ts", "label": "auth.config.ts", "file_type": "code", "source_file": "FIXING-0.0.0.0-REDIRECT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "fixing_0_0_0_0_redirect_smart_redirect_callback", "target": "fixing_0_0_0_0_redirect_auth_config_ts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FIXING-0.0.0.0-REDIRECT.md", "source_location": null, "weight": 1.0}, {"source": "fixing_0_0_0_0_redirect_issue", "target": "fixing_0_0_0_0_redirect_nextauth_url", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "FIXING-0.0.0.0-REDIREC